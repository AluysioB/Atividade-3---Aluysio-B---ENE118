#:kivy 2.3.1

<LeituraScreen>:
    name: "leitura"

    BoxLayout:
        orientation: "vertical"
        padding: 20
        spacing: 15

        canvas.before:
            Color:
                rgb: 0.94, 0.94, 0.94

            Rectangle:
                pos: self.pos
                size: self.size

        # =============================================
        # TÍTULO
        # =============================================

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: 60
            spacing: 0

            Label:
                text: "Leitura Modbus"
                font_size: 28
                bold: True
                color: 0, 0, 0, 1

            Label:
                text: "Consulta de dados do servidor Modbus TCP"
                color: 0, 0, 0, 1
                font_size: 14

        # =============================================
        # CARD 1 - CONFIGURAÇÃO
        # =============================================

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: 230
            spacing: 10
            padding: 15

            canvas.before:
                Color:
                    rgb: 1, 1, 1

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10]

            BoxLayout:
                size_hint_y: None
                height: 40

                Label:
                    text: "Endereço:"
                    color: 0, 0, 0, 1
                    size_hint_x: 0.25

                TextInput:
                    id: txt_endereco
                    text: "1000"
                    multiline: False

            BoxLayout:
                size_hint_y: None
                height: 40

                Label:
                    text: "Tipo:"
                    color: 0, 0, 0, 1
                    size_hint_x: 0.25

                Spinner:
                    id: sp_tipo
                    text: "Holding Register"
                    values: ["Holding Register","Input Register","Float","Coil","Discrete Input"]
            BoxLayout:
                size_hint_y: None
                height: 40

                Label:
                    text: "Contínua:"
                    color: 0, 0, 0, 1
                    size_hint_x: 0.25

                CheckBox:
                    id: cb_continuo
                    size_hint_x: None
                    width: 50

                Widget:

            Button:
                id: bt_ler
                text: "Ler"
                size_hint_y: None
                height: 50

                on_release:
                    root.comando_leitura()

        # =============================================
        # CARD 2 - RESULTADO
        # =============================================

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: 170
            spacing: 10
            padding: 15

            canvas.before:
                Color:
                    rgb: 1, 1, 1

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10]

            Label:
                text: "Resultado"
                font_size: 20
                bold: True
                color: 0, 0, 0, 1
                size_hint_y: None
                height: 35

            Label:
                id: lbl_resultado
                text: "---"
                font_size: 40
                bold: True
                color: 0.1, 0.2, 0.7, 1

        # =============================================
        # CARD 3 - INFORMAÇÕES
        # =============================================

        BoxLayout:
            orientation: "vertical"
            spacing: 10
            padding: 15

            canvas.before:
                Color:
                    rgb: 1, 1, 1

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10]

            Label:
                text: "Informações"
                font_size: 20
                bold: True
                color: 0, 0, 0, 1
                size_hint_y: None
                height: 35

            GridLayout:
                cols: 2
                spacing: 10

                Label:
                    text: "Última leitura:"
                    color: 0, 0, 0, 1

                Label:
                    id: lbl_horario_leitura
                    text: "---"
                    color: 0, 0, 0, 1

                Label:
                    text: "Tipo selecionado:"
                    color: 0, 0, 0, 1

                Label:
                    id: lbl_tipo_lido
                    text: "---"
                    color: 0, 0, 0, 1